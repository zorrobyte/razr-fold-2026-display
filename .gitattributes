# --- Git LFS (large binaries) ---
*.apk filter=lfs diff=lfs merge=lfs -text
*.img filter=lfs diff=lfs merge=lfs -text
*.ko  filter=lfs diff=lfs merge=lfs -text
*.jar filter=lfs diff=lfs merge=lfs -text

# --- Force LF on everything that runs on-device ---
# Android's sh/toybox chokes on CRLF: `set -e\r` -> "set: -: unknown option".
# These are consumed by `magisk --install-module` or `adb shell su -c sh ...`,
# so they MUST check out with Unix line endings even on Windows.
*.sh   text eol=lf
*.py   text eol=lf
*.prop text eol=lf
*.md   text eol=lf
vendor_dlkm_file_contexts text eol=lf
